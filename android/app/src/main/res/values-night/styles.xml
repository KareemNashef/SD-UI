<?xml version="1.0" encoding="utf-8"?>
<!-- The night variants differ only in that @color/desk resolves darker;
     the themes themselves are identical, so the parent stays Light rather
     than Theme.Black. Theme.Black was the source of the pure-black launch
     screen this replaces. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/desk</item>
    </style>
</resources>
