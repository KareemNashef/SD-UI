<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 launch window: the desk, with the iris centred on it.
     Android 12+ ignores this and uses the splash screen API instead - see
     values-v31/styles.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/desk" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_icon" />
    </item>
</layer-list>
