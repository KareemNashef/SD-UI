<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the process starts, on Android 11 and below. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Shown from the moment the process is up until Flutter paints its
         first frame. It used to inherit ?android:colorBackground, which is
         white here and black under the night theme - so the launch handed
         over to a flash of the wrong colour. Pinning it to the desk makes
         the whole start-up one continuous surface. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/desk</item>
    </style>
</resources>
